# ===============================================================================
# SECURITY & PRIVACY SHIELD: .gitignore (WEPAPP)
# ===============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Temporary and Cache Directories
.tempmediaStorage/
.cache/
*.tmp
*.temp
scratch/
~$*
~$*.xlsx
~$*.docx

# Environment Variables & Sensitive Credentials
.env
.env.*
secrets.json

# Operating System & IDE Artifacts
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.idea/
.vscode/

# Build and Playwright Artifacts
*.log
test-results/
verified_*.png

.vercel
